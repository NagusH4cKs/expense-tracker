# Use the connection string for a Neon project that you own.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Generate a unique random value of at least 32 characters. Never commit it.
JWT_SECRET="replace-with-a-private-random-secret-at-least-32-characters"

# Set true only while creating the first account, then change to false.
ALLOW_REGISTRATION="true"

PORT="5000"
# In production, set this to the exact Vercel frontend origin.
CORS_ORIGIN="http://localhost:5173"
